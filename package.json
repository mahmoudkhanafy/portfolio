{
  "name": "mahmoud-khaled-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio of Mahmoud Khaled, video editor and videographer in Giza / Cairo.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "media": "node scripts/media/build.ts",
    "dev": "npm run media && astro dev",
    "build": "npm run media && astro build",
    "build:e2e": "node scripts/e2e-work.ts && node scripts/media/build.ts --work .e2e-work && SITE_URL=http://localhost:4751 astro build",
    "serve": "node scripts/serve.ts --dir dist",
    "preview": "npm run build && npm run serve",
    "check": "astro check",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "brand": "node scripts/brand/render.ts",
    "lighthouse": "node scripts/lighthouse.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.4",
    "sharp": "^0.35.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "lighthouse": "^13.5.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}

---
import { TOOLS, ui } from '../lib/i18n.ts';
import { dirOf } from '../lib/site.ts';
import type { Lang } from '../lib/urls.ts';
import { RHYTHM } from '../lib/words.ts';
import Words from './Words.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<section id="about" class="about band" aria-labelledby="about-heading">
  <div class="about__intro">
    <p class="eyebrow"><span class="num" lang="en">02</span> / {t.aboutEyebrow}</p>
    <h2 id="about-heading" data-build="view"><Words text={t.aboutHeading} dir={dirOf(lang)} rhythm={RHYTHM.heading} /></h2>
  </div>
  <div class="about__detail">
    <p class="about__text">{t.about}</p>
    <div class="about__columns">
      <div>
        <h3>{t.servicesHeading}</h3>
        <ul class="about__list" role="list" data-build="view">
          {t.services.map((service, i) => <li class="pop" style={`--d: ${i * RHYTHM.services.step}ms`}>{service}</li>)}
        </ul>
      </div>
      <div>
        <h3>{t.toolsHeading}</h3>
        <ul class="about__tools" role="list" lang="en" dir="ltr">
          {TOOLS.map((tool) => <li>{tool}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    --band: var(--soft);
    display: grid;
    gap: 1.5rem;
    margin-top: clamp(4rem, 3rem + 5vw, 7rem);
    padding: clamp(3rem, 2rem + 4vw, 5.5rem) var(--gutter);
    scroll-margin-top: 0;
  }

  .about h2 {
    margin-top: 0.75rem;
    font-size: var(--step-3);
    line-height: 1.5;
    letter-spacing: -0.02em;
  }

  .about h2:lang(en) {
    font-size: clamp(2.75rem, 1.7rem + 3.4vw, 4.1rem);
    line-height: 1.08;
  }

  .about__detail {
    display: grid;
    gap: 2rem;
  }

  .about__text {
    max-width: var(--measure);
    font-size: var(--step-0);
    line-height: 2;
  }

  .about__text:lang(en) {
    line-height: 1.8;
  }

  .about__columns {
    display: grid;
    gap: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid #c9c6bd;
  }

  .about h3 {
    margin-bottom: 0.75rem;
    color: var(--muted);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .about__list {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--step-1);
    font-weight: 500;
  }

  /* Each service pops on from the reading start, and its rule draws in from there (motion.css). */
  .about__list li {
    position: relative;
    padding-bottom: 0.5rem;
    transform-origin: right center;
  }

  .about__list li::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 1px;
    background: #c9c6bd;
    transform-origin: right center;
  }

  .about__list:dir(ltr) li,
  .about__list:dir(ltr) li::after {
    transform-origin: left center;
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    :global(.motion) .about__list:not(.is-built) li::after {
      transform: scaleX(0);
    }

    :global(.motion) .about__list.is-building li::after {
      animation: rule-in 520ms var(--ease-cut) calc(var(--d) + 120ms) both;
    }
  }

  @keyframes rule-in {
    from {
      transform: scaleX(0);
    }
    to {
      transform: none;
    }
  }

  /* The tools in the display face. They keep their English order on both pages, and on the Arabic page
     line up with its reading start. */
  .about__tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--display);
    font-size: 1.2rem;
  }

  :global([dir='rtl']) .about__tools {
    justify-content: flex-end;
  }

  @media (min-width: 900px) {
    .about {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      column-gap: clamp(2rem, 1rem + 6vw, 8rem);
    }

    .about__detail {
      padding-top: 2.5rem;
    }

    .about__columns {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    }
  }
</style>

---
import { TOOLS, ui } from '../lib/i18n.ts';
import { dirOf } from '../lib/site.ts';
import type { Lang } from '../lib/urls.ts';
import { RHYTHM } from '../lib/words.ts';
import Words from './Words.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<section id="about" class="about" aria-labelledby="about-heading">
  <h2 id="about-heading" data-build="view"><Words text={t.aboutHeading} dir={dirOf(lang)} rhythm={RHYTHM.heading} /></h2>
  <p class="about__text">{t.about}</p>
  <div class="about__columns">
    <div>
      <h3>{t.servicesHeading}</h3>
      <ul class="about__list" role="list" data-build="view">
        {t.services.map((service, i) => <li class="pop" style={`--d: ${i * RHYTHM.services.step}ms`}>{service}</li>)}
      </ul>
    </div>
    <div>
      <h3>{t.toolsHeading}</h3>
      <ul class="about__tools" role="list">
        {
          TOOLS.map((tool) => (
            <li class="chip" lang="en" dir="ltr">
              {tool}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: 1.5rem;
    padding: clamp(4rem, 3rem + 5vw, 7rem) var(--gutter) clamp(3rem, 2rem + 4vw, 5rem);
  }

  .about h2 {
    font-size: var(--step-3);
    font-weight: 900;
  }

  .about__text {
    max-width: var(--measure);
    color: var(--white);
    font-size: var(--step-1);
    font-weight: 400;
    line-height: 1.7;
  }

  .about__columns {
    display: grid;
    gap: 2rem;
    margin-top: 0.5rem;
  }

  .about h3 {
    margin-bottom: 0.75rem;
    color: var(--dim);
    font-size: var(--step-0);
    font-weight: 600;
  }

  .about__list {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--white);
    font-size: var(--step-1);
    font-weight: 500;
  }

  /* Each service pops on from the reading start, and its rule draws in from there (motion.css). */
  .about__list li {
    position: relative;
    padding-bottom: 0.5rem;
    transform-origin: right center;
  }

  .about__list li::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 1px;
    background: var(--rule);
    transform-origin: right center;
  }

  .about__list:dir(ltr) li,
  .about__list:dir(ltr) li::after {
    transform-origin: left center;
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    :global(.motion) .about__list:not(.is-built) li::after {
      transform: scaleX(0);
    }

    :global(.motion) .about__list.is-building li::after {
      animation: rule-in 520ms var(--ease-cut) calc(var(--d) + 120ms) both;
    }
  }

  @keyframes rule-in {
    from {
      transform: scaleX(0);
    }
    to {
      transform: none;
    }
  }

  .about__tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 900px) {
    .about {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: clamp(2rem, 1rem + 5vw, 6rem);
    }

    .about h2 {
      grid-column: 1 / -1;
    }

    .about__columns {
      margin-top: 0;
    }
  }
</style>

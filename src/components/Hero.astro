---
import type { Portrait } from '../lib/catalog.ts';
import { whatsappMessage, whatsappUrl } from '../lib/contact.ts';
import { ui } from '../lib/i18n.ts';
import { dirOf, href } from '../lib/site.ts';
import type { Lang } from '../lib/urls.ts';
import { RHYTHM } from '../lib/words.ts';
import Icon from './Icon.astro';
import Words from './Words.astro';

interface Props {
  lang: Lang;
  portrait: Portrait | null;
}

/** On phones the portrait is cropped closer: drawn at 160% of a column about half the screen wide. */
export const HERO_SIZES = '(min-width: 900px) 42vw, (min-width: 600px) min(30.4rem, calc(82vw - 3rem)), min(24rem, calc(82vw - 3rem))';

const { lang, portrait } = Astro.props;
const t = ui[lang];
const [first, ...rest] = t.name.split(' ');
const srcset = (list: Array<{ src: string; width: number }>) => list.map((s) => `${href(s.src)} ${s.width}w`).join(', ');
---

<section class="hero" aria-labelledby="hero-name">
  <p class="hero__eyebrow eyebrow">
    <span class="hero__square" aria-hidden="true"></span>
    {t.role}
    <span class="hero__place">{t.place}</span>
  </p>
  <h1 id="hero-name" class="hero__name">
    <span class="hero__first">{first}</span>
    <span class="hero__last">{rest.join(' ')}<span class="hero__dot" aria-hidden="true">.</span></span>
  </h1>
  <div class="hero__copy">
    <p class="hero__lead" data-build="load"><Words text={t.heroLead} dir={dirOf(lang)} rhythm={RHYTHM.hero} /></p>
    <p class="hero__summary">{t.heroSummary}</p>
  </div>
  <div class="hero__actions">
    <a class="button button--primary" href={whatsappUrl(whatsappMessage(lang))}>
      <Icon name="whatsapp" />
      {t.whatsapp}
    </a>
    <a class="button button--ghost hero__next" href="#work">
      {t.seeWork}
      <span class="hero__cue" aria-hidden="true"><Icon name="down" size={18} /></span>
    </a>
  </div>
  <div class="hero__art">
    <span class="hero__vertical" aria-hidden="true">{t.heroVertical}</span>
    {
      portrait && (
        <picture class="hero__portrait">
          <source type="image/avif" srcset={srcset(portrait.avif)} sizes={HERO_SIZES} />
          <source type="image/webp" srcset={srcset(portrait.webp)} sizes={HERO_SIZES} />
          <img src={href(portrait.png.src)} width={portrait.width} height={portrait.height} alt={t.portraitAlt} fetchpriority="high" decoding="async" />
        </picture>
      )
    }
    <p class="hero__caption" aria-hidden="true">
      <span>{t.portraitCaption[0]}<br />{t.portraitCaption[1]}</span>
      <span class="hero__cross">+</span>
    </p>
  </div>
  <p class="hero__strip" aria-hidden="true">
    <span lang="en" dir="ltr">Mahmoud Khaled</span>
    <span class="hero__strip-arrow">↓</span>
    <span>{t.selectedWork}</span>
  </p>
</section>

<style>
  /* Phones: name, then the line beside a close crop of the portrait, then the actions. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    grid-template-areas:
      'eyebrow eyebrow'
      'name name'
      'copy art'
      'actions actions'
      'strip strip';
    column-gap: 1.1rem;
    padding: 1.5rem var(--gutter) 0;
  }

  .hero__eyebrow {
    grid-area: eyebrow;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
  }

  .hero__square {
    width: 7px;
    height: 7px;
    background: var(--accent);
  }

  .hero__place {
    padding-inline-start: 0.6rem;
    border-inline-start: 1px solid var(--line);
    color: var(--muted);
    font-weight: 400;
  }

  .hero__name {
    grid-area: name;
    display: grid;
    justify-items: start;
    margin-block: 0.5rem 1.25rem;
    font-size: clamp(3.1rem, 1.6rem + 7vw, 4.4rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .hero__name:lang(en) {
    font-size: clamp(3.75rem, 1.8rem + 11vw, 5.25rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.02em;
  }

  .hero__dot {
    color: var(--accent);
  }

  .hero__copy {
    grid-area: copy;
    align-self: end;
    display: grid;
    gap: 0.6rem;
    padding-bottom: 0.25rem;
  }

  /* Positioned: the kashida stretch (motion.ts) measures the room left on its line against it. */
  .hero__lead {
    position: relative;
    color: var(--ink);
    text-wrap: balance;
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.6;
  }

  .hero__lead:lang(en) {
    line-height: 1.4;
  }

  .hero__summary {
    color: var(--muted);
    font-size: var(--step--1);
    line-height: 1.7;
  }

  .hero__actions {
    grid-area: actions;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .hero__cue {
    display: grid;
    overflow: hidden;
  }

  /* The portrait stands on an orange block, in black and white, its head and shoulders on phones. */
  .hero__art {
    grid-area: art;
    position: relative;
    align-self: end;
    justify-self: end;
    width: 100%;
    max-width: 15rem;
    aspect-ratio: 0.78;
    overflow: hidden;
    isolation: isolate;
  }

  .hero__art::before {
    content: '';
    position: absolute;
    inset: 25% 0 0;
    z-index: -1;
    background: var(--accent);
  }

  .hero__portrait img {
    position: absolute;
    top: -0.5rem;
    left: 50%;
    width: 160%;
    max-width: none;
    height: auto;
    filter: grayscale(1);
    translate: -50% 0;
  }

  .hero__vertical,
  .hero__caption {
    display: none;
  }

  .hero__strip {
    grid-area: strip;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.75rem;
    margin-top: 1.75rem;
    border-top: 1px solid var(--line);
    font-size: 0.7rem;
    direction: ltr;
  }

  /* Spaced capitals for the English words only: spacing would break the joins of Arabic letters. */
  .hero__strip :lang(en) {
    font-family: var(--display);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero__strip .hero__strip-arrow {
    font-family: Arial, sans-serif;
    font-size: 1.25rem;
    letter-spacing: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__first,
    .hero__last {
      animation: wipe-in 620ms var(--ease-cut) 120ms both;
    }

    .hero__last {
      animation-delay: 300ms;
    }

    .hero__art {
      animation: arrive 800ms var(--ease-cut) 80ms both;
    }

    .hero__cue :global(svg) {
      animation: cue-drop 2.4s 3.6s 3 both;
    }

    @media (hover: hover) {
      .hero__next:hover .hero__cue :global(svg) {
        animation: cue-drop 1.1s;
      }
    }
  }

  @keyframes arrive {
    from {
      opacity: 0;
      translate: 0 15px;
    }
  }

  /* Out through the bottom, back in from the top, then a rest before the next cue. */
  @keyframes cue-drop {
    0%,
    12% {
      transform: translateY(0);
      opacity: 1;
      animation-timing-function: cubic-bezier(0.55, 0, 1, 0.45);
    }
    30% {
      transform: translateY(160%);
      opacity: 0;
    }
    31% {
      transform: translateY(-160%);
      opacity: 0;
      animation-timing-function: var(--ease-cut);
    }
    50%,
    100% {
      transform: translateY(0);
      opacity: 1;
    }
  }

  /* Each line of the name wipes open from the reading start: the right edge in Arabic, the left in English. */
  @keyframes wipe-in {
    from {
      clip-path: inset(0 0 0 100%);
    }
    to {
      clip-path: inset(0);
    }
  }

  :global([dir='ltr']) .hero__first,
  :global([dir='ltr']) .hero__last {
    animation-name: wipe-in-ltr;
  }

  @keyframes wipe-in-ltr {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0);
    }
  }

  @media (min-width: 600px) {
    .hero__art {
      max-width: 19rem;
    }

    .hero__lead {
      font-size: var(--step-2);
    }
  }

  /* Wider screens: the words on one side, the portrait whole on its block on the other. */
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: 1fr auto auto auto auto 1fr auto;
      grid-template-areas:
        '. art'
        'eyebrow art'
        'name art'
        'copy art'
        'actions art'
        '. art'
        'strip strip';
      column-gap: clamp(2rem, 3vw, 4rem);
      min-height: min(48rem, calc(100svh - 5.25rem));
      padding-top: clamp(1.5rem, 4svh, 3.5rem);
    }

    .hero__name {
      margin-block: 1.25rem 1.5rem;
      font-size: clamp(4.25rem, 1rem + 6.6vw, 8.25rem);
      line-height: 1.1;
    }

    .hero__name:lang(en) {
      font-size: clamp(5.25rem, 1.2rem + 7.4vw, 9.4rem);
      line-height: 0.91;
    }

    .hero__last {
      padding-inline-start: 0.6em;
    }

    .hero__copy {
      align-self: start;
      max-width: 28rem;
      padding-bottom: 0;
    }

    .hero__actions {
      margin-top: 1.75rem;
    }

    .hero__art {
      align-self: stretch;
      max-width: none;
      aspect-ratio: auto;
      min-height: 26rem;
      overflow: visible;
    }

    .hero__art::before {
      inset: 8% 8% 5% 0;
    }

    .hero__art:dir(ltr)::before {
      inset: 8% 0 5% 8%;
    }

    .hero__portrait {
      position: absolute;
      inset: 0;
      overflow: hidden;
    }

    .hero__portrait img {
      top: auto;
      bottom: 0;
      width: auto;
      height: 108%;
      max-height: 40rem;
      max-width: 100%;
      object-fit: contain;
      object-position: 50% 100%;
      translate: -50% 4%;
    }

    .hero__vertical {
      display: block;
      position: absolute;
      top: 0;
      inset-inline-end: 0.25rem;
      writing-mode: vertical-rl;
      font-size: 0.8rem;
    }

    .hero__vertical:lang(en) {
      font-family: var(--display);
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .hero__caption {
      display: flex;
      align-items: center;
      gap: 2.5rem;
      position: absolute;
      bottom: 0;
      inset-inline-start: 0;
      z-index: 1;
      padding: 0.85rem 1.25rem;
      background: var(--paper);
      font-size: var(--step--1);
      line-height: 1.7;
    }

    .hero__cross {
      font-size: 2.5rem;
      font-weight: 400;
      line-height: 1;
    }

    .hero__strip {
      margin-top: clamp(1.5rem, 4svh, 3rem);
      font-size: 0.75rem;
    }
  }
</style>

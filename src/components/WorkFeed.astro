---
import type { Work } from '../lib/catalog.ts';
import { ui, videoCount } from '../lib/i18n.ts';
import { ratioOf } from '../lib/localize.ts';
import { pieceOf } from '../lib/phone.ts';
import { FEED_ROWS, layRows, type FeedLayout, type RowPlace } from '../lib/rows.ts';
import { dirOf } from '../lib/site.ts';
import type { Lang } from '../lib/urls.ts';
import { RHYTHM } from '../lib/words.ts';
import Reel from './Reel.astro';
import Words from './Words.astro';

interface Props {
  lang: Lang;
  works: Work[];
}

const { lang, works } = Astro.props;
const t = ui[lang];
const pieces = works.map((work) => pieceOf(ratioOf(work.width, work.height)));
const layouts = Object.entries(FEED_ROWS).map(([name, layout]) => [name, layRows(pieces, layout)] as const);
const rowsOf = (i: number) => Object.fromEntries(layouts.map(([name, places]) => [name, places[i]!])) as Record<FeedLayout, RowPlace>;
---

<section id="work" class="feed" aria-labelledby="work-heading">
  <div class="feed__head">
    <div>
      <p class="eyebrow"><span class="num" lang="en">01</span> / {t.workEyebrow}</p>
      <h2 id="work-heading" data-build="view"><Words text={t.workHeading} dir={dirOf(lang)} rhythm={RHYTHM.heading} /></h2>
    </div>
    <p class="feed__intro">{t.workIntro[0]}<br />{t.workIntro[1]}</p>
  </div>
  <p class="feed__count eyebrow">{videoCount(works.length, lang)}</p>
  <div class="feed__list">
    {works.map((work, i) => <Reel work={work} lang={lang} rows={rowsOf(i)} />)}
  </div>
</section>

<style>
  .feed {
    padding-inline: var(--gutter);
    padding-top: clamp(3rem, 2rem + 4vw, 5.5rem);
    /* The header links to #work: the heading lands just below the top of the screen. */
    scroll-margin-top: 0.5rem;
  }

  .feed__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-bottom: 1.5rem;
  }

  .feed__head h2 {
    margin-top: 0.5rem;
    font-size: var(--step-3);
    letter-spacing: -0.02em;
  }

  .feed__head h2:lang(en) {
    font-size: clamp(2.5rem, 1.6rem + 3vw, 3.9rem);
  }

  .feed__intro {
    color: var(--muted);
    font-size: var(--step--1);
    line-height: 1.9;
  }

  .feed__count {
    padding-block: 1rem 0;
    border-top: 1px solid var(--line);
  }

  .feed__list {
    display: grid;
    gap: 3.5rem;
    padding-top: 1.25rem;
  }

  /* Wider screens: rows laid out by lib/rows.ts, each piece sized by Reel.astro. Pieces keep the
     reading order of the page; only where a film waits for a row of its own do the pieces after it
     move up on screen. */
  @media (min-width: 760px) {
    .feed__list {
      --gap: clamp(1.25rem, 0.5rem + 2vw, 2.5rem);
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: clamp(2.5rem, 1.5rem + 3vw, 4rem) var(--gap);
      padding-top: 1.5rem;
    }
  }
</style>

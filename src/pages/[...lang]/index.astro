---
import About from '../../components/About.astro';
import Contact from '../../components/Contact.astro';
import Hero, { HERO_SIZES } from '../../components/Hero.astro';
import WorkFeed from '../../components/WorkFeed.astro';
import Base from '../../layouts/Base.astro';
import { catalog } from '../../lib/catalog.ts';
import { ui } from '../../lib/i18n.ts';
import { profilePageLd, websiteLd } from '../../lib/jsonld.ts';
import { abs, absVersioned, href, otherLang, pageAbs } from '../../lib/site.ts';
import { pagePath, type Lang } from '../../lib/urls.ts';

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'ar' } }];
}

const lang: Lang = Astro.params.lang === 'ar' ? 'ar' : 'en';
const t = ui[lang];
const { portrait, works } = catalog;
// The card with his name first in the page's language (npm run brand).
const ogImage = absVersioned(lang === 'en' ? 'og-home-en.jpg' : 'og-home.jpg');
const preload = portrait
  ? { imagesrcset: portrait.avif.map((s) => `${href(s.src)} ${s.width}w`).join(', '), imagesizes: HERO_SIZES, type: 'image/avif' }
  : undefined;
---

<Base
  lang={lang}
  title={t.homeTitle}
  description={t.homeDescription}
  path={pagePath(lang)}
  altPath={pagePath(otherLang(lang))}
  og={{ image: ogImage, width: 1200, height: 630, alt: t.ogHomeAlt, type: 'website' }}
  jsonLd={[websiteLd({ url: pageAbs(lang), lang }), profilePageLd({ url: pageAbs(lang), image: portrait ? abs(portrait.webp.at(-1)!.src) : ogImage, lang })]}
  preload={preload}
  home
>
  <Hero lang={lang} portrait={portrait} />
  <WorkFeed lang={lang} works={works} />
  <About lang={lang} />
  <Contact lang={lang} />
</Base>

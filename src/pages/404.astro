---
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import { ui } from '../lib/i18n.ts';
import { abs, pageHref } from '../lib/site.ts';

// One page for every language: GitHub Pages serves it for any missing address under the site.
const ar = ui.ar;
const en = ui.en;
---

<Base
  lang="en"
  title={`${en.notFoundTitle} — ${en.name}`}
  description={en.notFoundBody}
  path="404.html"
  altPath="404.html"
  og={{ image: abs('og-home-en.jpg'), width: 1200, height: 630, alt: en.ogHomeAlt, type: 'website' }}
  noindex
>
  <section class="missing" aria-labelledby="missing-en">
    <div>
      <h1 id="missing-en">{en.notFoundTitle}</h1>
      <p>{en.notFoundBody}</p>
      <a class="button button--primary" href={pageHref('en')}>{en.backHome}</a>
    </div>
    <div lang="ar" dir="rtl">
      <h2>{ar.notFoundTitle}</h2>
      <p>{ar.notFoundBody}</p>
      <a class="button button--ghost" href={pageHref('ar')}>
        <Icon name="back" size={18} />
        {ar.backHome}
      </a>
    </div>
  </section>
</Base>

<style>
  .missing {
    display: grid;
    gap: 3rem;
    padding: clamp(3rem, 2rem + 6vw, 7rem) var(--gutter);
  }

  .missing > div {
    display: grid;
    justify-items: start;
    gap: 1rem;
  }

  .missing h1,
  .missing h2 {
    font-size: var(--step-3);
    font-weight: 700;
  }

  .missing p {
    color: var(--muted);
  }
</style>

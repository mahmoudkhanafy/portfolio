---
/**
 * The site lived at mahmoudkhanafy.github.io/portfolio/, Arabic at its root and English under en/,
 * before it moved to the root of the domain with English first; links shared then (in WhatsApp chats,
 * on Instagram) still open the same page in the same language.
 */
import Redirect from '../../components/Redirect.astro';
import { works } from '../../lib/catalog.ts';
import { pageAbs } from '../../lib/site.ts';
import { oldPagePath, type Lang } from '../../lib/urls.ts';

export function getStaticPaths() {
  return (['ar', 'en'] as const).flatMap((lang) =>
    [undefined, ...works.map((work) => work.slug)].map((slug) => ({
      params: { path: oldPagePath(lang, slug).replace(/\/$/, '') || undefined },
      props: { lang, slug },
    })),
  );
}

interface Props {
  lang: Lang;
  slug?: string;
}

const { lang, slug } = Astro.props;
---

<Redirect lang={lang} target={pageAbs(lang, slug)} />
